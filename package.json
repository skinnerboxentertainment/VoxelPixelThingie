{
  "name": "voxelpixelthingie",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "VoxelPixelBit core model. See SPEC.md.",
  "scripts": {
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "test:coverage": "c8 --check-coverage --lines 85 --include \"src/**\" npm test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^22.0.0",
    "c8": "^12.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "lint-staged": {
    "*.{ts,js,json}": "biome check --write --no-errors-on-unmatched"
  }
}
